<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/settings_subtitle"
        android:textAppearance="@style/TextAppearance.App.Label" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_interval"
        style="@style/Widget.App.TextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="@string/hint_interval"
        app:helperText="@string/helper_interval">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNext"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:text="0.3"
            android:textSize="@dimen/text_input" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_altitude"
        style="@style/Widget.App.TextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/hint_altitude">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_altitude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:maxLines="1"
            android:text="0"
            android:textSize="@dimen/text_input" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_acceleration"
        style="@style/Widget.App.TextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/hint_acceleration">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_acceleration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:text="0.0"
            android:textSize="@dimen/text_input" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_speed_variance"
        style="@style/Widget.App.TextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/hint_speed_variance"
        app:helperText="@string/helper_speed_variance">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_speed_variance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:maxLines="1"
            android:text="5"
            android:textSize="@dimen/text_input" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_keep_screen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:text="@string/switch_keep_screen"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_body" />

    <TextView
        android:id="@+id/tv_settings_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/settings_hint"
        android:textAppearance="@style/TextAppearance.App.Label.Small" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_open_repo"
        style="@style/Widget.App.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_button_small"
        android:layout_marginTop="16dp"
        android:text="@string/open_repo"
        app:icon="@drawable/ic_info"
        app:iconGravity="textStart"
        app:iconSize="18dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_settings_done"
        style="@style/Widget.App.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_button"
        android:layout_marginTop="16dp"
        android:text="@string/btn_done" />
</LinearLayout>
