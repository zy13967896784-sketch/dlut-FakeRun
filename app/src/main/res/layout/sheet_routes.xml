<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/tv_routes_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/route_library_title"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_routes_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/route_library_hint"
        android:textAppearance="@style/TextAppearance.App.Label" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_routes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_import_file"
        style="@style/Widget.App.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_button_small"
        android:layout_marginTop="12dp"
        android:text="@string/btn_import_file"
        app:icon="@drawable/ic_import"
        app:iconGravity="textStart"
        app:iconSize="18dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_draw_route"
        style="@style/Widget.App.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_button_small"
        android:layout_marginTop="8dp"
        android:text="@string/btn_draw_route"
        app:icon="@drawable/ic_route"
        app:iconGravity="textStart"
        app:iconSize="18dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_paste_route"
        style="@style/Widget.App.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_button_small"
        android:layout_marginTop="8dp"
        android:text="@string/btn_paste_route"
        app:icon="@drawable/ic_paste"
        app:iconGravity="textStart"
        app:iconSize="18dp" />
</LinearLayout>
